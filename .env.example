# --- Server -------------------------------------------------------------------
PORT=4001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Number of reverse proxies in front of the app (e.g. 1 behind an ingress). 0 = none.
TRUST_PROXY=0
# Comma-separated list of origins allowed to call /api cross-origin. Empty = same-origin only.
CORS_ORIGIN=
# When set (min. 16 chars), adding/removing documents requires "Authorization: Bearer <token>".
API_TOKEN=

# --- LLM provider ---------------------------------------------------------------
# demo      = offline rule-based extraction + extractive answers (no LLM, no credentials)
# anthropic = Claude via the official Anthropic SDK
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=120000

# --- Graph / retrieval -----------------------------------------------------------
DATA_DIR=./data
MAX_DOCUMENT_CHARS=200000
CHUNK_SIZE=1200
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=12000
EXTRACTION_CONCURRENCY=3

# --- Rate limits (per client IP, per window) ------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WRITES=10
RATE_LIMIT_QUERIES=60
SHUTDOWN_TIMEOUT_MS=10000
