{
  "openapi": "3.0.3",
  "info": {
    "title": "GraphRAG Vision API",
    "version": "2.0.0",
    "description": "Index documents into a knowledge graph (entity/relation extraction) and ask questions answered from the graph with cited sources. When the server runs with LLM_PROVIDER=demo, extraction is rule-based and answers are extractive (no language model)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required on write routes only when API_TOKEN is configured."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error",
          "code"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "chunks": {
            "type": "integer"
          }
        }
      },
      "Graph": {
        "type": "object",
        "description": "Cytoscape.js elements plus counters.",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "company",
                        "person",
                        "product",
                        "metric",
                        "location",
                        "concept"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "degree": {
                      "type": "integer"
                    },
                    "mentions": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "valid_from": {
                      "type": "integer",
                      "nullable": true
                    },
                    "valid_until": {
                      "type": "integer",
                      "nullable": true
                    },
                    "sources": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "documents": {
                "type": "integer"
              },
              "chunks": {
                "type": "integer"
              },
              "entities": {
                "type": "integer"
              },
              "relations": {
                "type": "integer"
              }
            }
          }
        }
      },
      "IngestResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "created": {
            "type": "boolean",
            "description": "false when an identical document was already indexed"
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "graph": {
            "$ref": "#/components/schemas/Graph"
          }
        }
      },
      "Citation": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer"
          },
          "documentId": {
            "type": "string"
          },
          "documentTitle": {
            "type": "string"
          },
          "chunkId": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Process is up"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Graph loaded"
          },
          "503": {
            "description": "Starting"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Provider, limits and graph counters",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/graph": {
      "get": {
        "summary": "Current knowledge graph",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "graph": {
                      "$ref": "#/components/schemas/Graph"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "summary": "List indexed documents",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "documents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Document"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Index a document",
        "description": "Chunks the text, extracts entities/relations per chunk, merges them into the graph and persists it. Identical text is de-duplicated.",
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "text"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "text": {
                    "type": "string",
                    "minLength": 20,
                    "description": "Bounded by MAX_DOCUMENT_CHARS"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already indexed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "201": {
            "description": "Indexed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "LLM unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}": {
      "delete": {
        "summary": "Remove a document and everything only it supported",
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/process-document": {
      "post": {
        "summary": "Index the bundled fictional sample report (backwards-compatible endpoint)",
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Indexed or already indexed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/query": {
      "post": {
        "summary": "Ask a question",
        "description": "Retrieves the relevant subgraph and chunks, then answers citing sources as [n].",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "answer": {
                          "type": "string"
                        },
                        "highlightedNodes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "citations": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Citation"
                          }
                        },
                        "facts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "provider": {
                          "type": "string"
                        },
                        "demo": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
