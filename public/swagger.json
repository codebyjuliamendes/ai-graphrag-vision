{
  "openapi": "3.0.0",
  "info": {
    "title": "AI GraphRAG Vision API",
    "version": "1.0.0",
    "description": "API documentation for the Multimodal GraphRAG system."
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/process-document": {
      "post": {
        "summary": "Process Document",
        "description": "Triggers graph extraction from document",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "graph": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/query": {
      "post": {
        "summary": "Query Graph",
        "description": "Queries the knowledge graph using natural language",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  }
}
